# Node
node_modules/
npm-debug.log*

# Datos de ejecución (no son código, se regeneran / son estado local)
registro.json
*.respaldo_*
estado_ficha.json

# Secretos (heredado del sistema anterior; no debería volver a aparecer)
.env

# SO
Thumbs.db
.DS_Store

# Datos reales de aprendices e instructores (PII) usados como prueba local:
# nunca deben quedar en el historial de git (mismo criterio del commit inicial).
CONTROL_ASISTENCIA*.xlsx
HORARIOS*.pdf
Reporte de Aprendices*.xls*

# Actas reales (generadas, o de referencia) con datos de aprendices reales:
# nunca al repo, aunque queden sueltas en la raíz durante una prueba. Los
# archivos *_PLANTILLA.docx en plantilla/ no calzan con este patrón.
ACTA_*.docx
INFORME_COMITE_*.docx

# Estado local de herramientas (Claude Code), no es parte del proyecto.
.claude/

# Carpeta de trabajo de las pruebas automatizadas (se recrea en cada corrida).
pruebas/tmp/

# Salida de electron-builder (npm run dist), se regenera.
/dist/
